# Copie para .env e ajuste os valores. Nunca commite o .env.

# Senha do usuário sa do SQL Server. O banco sobe pelo repositório
# OrcamentoPagamento-InfraSGBD: use a MESMA senha definida no .env de lá.
SA_PASSWORD=SuaSenhaForte@123

# Mesma chave usada pela API do monólito e pela Lambda de autenticação: o microsserviço
# apenas valida os tokens emitidos por eles.
JWT_SECRET_KEY=sua-chave-jwt-secreta-com-no-minimo-32-caracteres


# ─── Pagamento (Mercado Pago) ─────────────────────────────────────────────────
# Nada aqui precisa ser preenchido para desenvolver: em false, o serviço usa o
# gateway fake e o resultado vem do próprio token enviado na requisição —
# APRO aprova, FUND recusa por saldo, CONT deixa pendente (e a consulta seguinte
# aprova, o que permite exercitar o webhook). Ver docs/pagamento.md, seção 5.
PAGAMENTOS_HABILITADO=false

# Access token de TESTE da aplicação (começa com TEST-), do painel do
# desenvolvedor em "Detalhes da aplicação > Credenciais".
#
# Atenção: precisa ser da MESMA aplicação cuja public key o time do Web usa para
# tokenizar o cartão. Token gerado pela public key de uma aplicação é rejeitado
# pelo access token de outra, e o erro não deixa isso óbvio.
MERCADOPAGO_ACCESS_TOKEN=

# Secret usado na validação do header x-signature das notificações.
# Vazio: o serviço aceita a notificação SEM validar a assinatura e registra um
# aviso no log. Serve para desenvolvimento; em produção significa rota pública
# sem autenticação nenhuma.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do webhook, também registrada no painel do Mercado Pago.
# Vazio: nenhuma notificação chega (localhost não recebe webhook). Use
# POST /api/pagamento/{id}/sincronizar para fechar o ciclo nesse caso.
MERCADOPAGO_NOTIFICATION_URL=

# Lembrete do fluxo de teste: o e-mail do payer precisa ser DIFERENTE do e-mail
# da sua conta Mercado Pago, senão o pagamento falha por um motivo que não parece
# ser esse. Fora isso, não é preciso criar conta de teste para este fluxo — as
# credenciais de teste saem da sua própria conta de produção.
